# EduPal configuration.
#
# Copy to `.env` for local development — main.py calls load_dotenv(), so the
# file is picked up automatically when you run `uvicorn main:app --reload`.
# In Coolify these are set in the resource's environment panel instead.
#
# NOTE: nothing validates these at start-up. A missing value does not crash the
# process; it surfaces later as a failure on whichever route needs it. If a
# single endpoint misbehaves, check its variables here first.
#
# There is no local docker-compose: EduPal needs MongoDB Atlas (see below), so
# local development points MONGO_URI at a real cluster — a dev/free-tier one is
# fine.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port uvicorn listens on. Also consumed by the Dockerfile as a build arg, so
# EXPOSE and the runtime listener stay in agreement.
PORT=8000

# ---------------------------------------------------------------------------
# Database — MongoDB Atlas
# ---------------------------------------------------------------------------

# Connection string. The code falls back to mongodb://localhost:27017/ if unset,
# which never works inside a container — always set it.
MONGO_URI=

# Atlas Admin API credentials, used by services/auth/auth_service.py to create
# the `embedding_vector_index` knnVector index.
#
# These are REQUIRED for:
#   - user registration            (services/auth/auth_api.py)
#   - OER collection creation      (services/database_management/OERs_api.py)
# Every other route works without them.
#
# A self-hosted MongoDB cannot serve these calls — the Admin API only manages
# Atlas clusters. Create the keys under Atlas → Access Manager → API Keys, at
# project level, with the Project Data Access Admin role.
ATLAS_PROJECT_ID=
ATLAS_CLUSTER_NAME=
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------

# Four independent signing secrets, so rotating one invalidates only the tokens
# it signs. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ACCESS_SECRET_KEY=
USERS_SECRET_KEY=
TOOLS_SECRET_KEY=
CHAT_SECRET_KEY=

ALGORITHM=HS256
# Access token lifetime, in minutes.
EXP_TIME=60

# ---------------------------------------------------------------------------
# Azure OpenAI
# ---------------------------------------------------------------------------

OPENAI_API_KEY=
# Resource endpoint, e.g. https://your-resource.openai.azure.com/
OPENAI_ENDPOINT=
# Deployment name, not the model name.
OPENAI_DEPLOYMENT_NAME=
# Separate deployment used for image generation.
AZURE_OPENAI_IMAGE_DEPLOYMENT=

# ---------------------------------------------------------------------------
# Groq
# ---------------------------------------------------------------------------
# Backs the "default" (shared, free-tier) model

GROQ_API_KEY=
# Swap to "openai/gpt-oss-20b" or "openai/gpt-oss-120b" to use Groq's built-in
# agentic tools (browser_search, code_interpreter) instead of Llama.
GROQ_MODEL=llama-3.3-70b-versatile
# Only needed if Groq's API endpoint ever changes.
GROQ_BASE_URL=https://api.groq.com/openai/v1


# ---------------------------------------------------------------------------
# Google
# ---------------------------------------------------------------------------

GEMINI_API_KEY=

# Programmable Search Engine, used for web grounding.
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------

# Cosine-similarity cutoff for vector search results.
# NOTE the spelling — the code reads SIMILARITY_THRSHOLD, not THRESHOLD.
SIMILARITY_THRSHOLD=0.5
